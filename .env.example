# Скопируйте этот файл в .env и заполните реальными значениями.
# Без OPENAI_API_KEY проект запускается в демо-режиме (заготовленные ответы),
# основной сценарий с ключом реально обращается к OpenAI API.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Опционально: NVIDIA NIM (OpenAI-совместимый API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

PORT=3000
