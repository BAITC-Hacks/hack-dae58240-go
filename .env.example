# Скопируйте этот файл в .env и при желании заполните значения.
# Без OPENAI_API_KEY проект запускается в демо-режиме: расчёт настоящий,
# заготовлен только текст ответа LLM. С ключом агент реально работает через OpenAI API.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Опционально: альтернативный OpenAI-совместимый адрес
OPENAI_BASE_URL=

PORT=3000

# Опционально: папка с данными (по умолчанию заказчик/, иначе data/demo/)
DATA_DIR=
# Сроки поставки в днях (в данных партнёра их нет — допущение)
LEAD_TIME_IEK=30
LEAD_TIME_DEFAULT=45

# Зарезервировано, в текущей версии не используется
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
